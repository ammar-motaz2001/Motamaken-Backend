# Cloudflare sits in front of the three domains (orange cloud): it terminates HTTPS for visitors and connects here.
# This server answers on both 80 and 443 (self-signed, which Cloudflare's "Full" SSL mode accepts) and never redirects,
# so it works with Cloudflare set to "Flexible" or "Full". Do not use "Full (strict)" without an origin certificate.
{
	auto_https disable_redirects
	servers {
		# Only Cloudflare may tell us the visitor's real IP (https://www.cloudflare.com/ips/).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(common) {
	tls internal
	encode zstd gzip
	header -Server
	request_body {
		max_size 25MB
	}
}

http://mutamakin.com, https://mutamakin.com, http://www.mutamakin.com, https://www.mutamakin.com {
	import common
	reverse_proxy web:3000
}

http://api.mutamakin.com, https://api.mutamakin.com {
	import common
	reverse_proxy api:10000
}

# The admin panel is part of the website.
http://admin.mutamakin.com, https://admin.mutamakin.com {
	import common
	redir https://mutamakin.com/admin 302
}
