APP_NAME=Mutamakin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=motamken
DB_USERNAME=motamken
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@motamakin.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3000
# Comma separated; add the deployed frontend, e.g. https://motamaken-front.vercel.app
CORS_ALLOWED_ORIGIN_PATTERNS='#^https://motamaken-front(-[a-z0-9-]+)?\.vercel\.app$#'
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://motamaken-front.vercel.app
# Login methods that need an OTP after the password (the frontend mock: email yes, phone no)
LOGIN_OTP_METHODS=
OTP_TTL_MINUTES=10
# Access token lifetime in minutes (30 days)
SANCTUM_EXPIRATION=43200

# reCAPTCHA v2 checkbox keys (https://www.google.com/recaptcha/admin). Empty = no captcha check.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Docker host port forwards
APP_PORT=8000
FORWARD_DB_PORT=5433
FORWARD_REDIS_PORT=6380

# Shared with the website server (motamken-web API_PROXY_SECRET): it forwards the visitor IP/browser signed with it
FRONTEND_PROXY_SECRET=

# Payment gateway: fake (development) or moyasar.
PAYMENTS_DRIVER=fake

# Moyasar (https://dashboard.moyasar.com → Settings → API keys). The publishable key goes to the website as
# NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY. Webhook: {APP_URL}/api/webhooks/moyasar with this secret token.
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
